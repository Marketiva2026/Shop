# Serveur
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://marketiva.ci

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketiva_db
DB_USER=marketiva_user
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRE=15m
REFRESH_SECRET=
REFRESH_EXPIRE=7d

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (images)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# CinetPay (paiements)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=

# Super Admin (créé au démarrage si n'existe pas)
SUPER_ADMIN_EMAIL=superadmin@marketiva.ci
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NOM=Super
SUPER_ADMIN_PRENOM=Administrateur
SUPER_ADMIN_TELEPHONE=+2250000000000
